@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-header">
    <h1>Privacy & Data Protection</h1>
    <p>
        How TechMove GLMS handles client, contract, document and financial information.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h4>🔐 Data Collected</h4>
            <p>
                GLMS stores client details, regions, contract records, service levels,
                service requests, uploaded PDF agreements and currency conversion values.
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h4>🎯 Purpose of Data Use</h4>
            <p>
                The data is used to manage logistics contracts, process service requests,
                track agreement documents and support reporting inside the prototype.
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h4>📄 Document Handling</h4>
            <p>
                Signed agreements are uploaded as PDF files only. The file name is stored in
                the database, while the actual file is saved on the server.
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4 h-100">
            <h4>💱 Currency API</h4>
            <p>
                The system uses an external exchange-rate API to convert USD values to ZAR.
                No client personal information is sent to the API.
            </p>
        </div>
    </div>
</div>

<div class="card p-4 mt-4">
    <h4>🛡️ Prototype Notice</h4>
    <p class="mb-0">
        This application is an academic prototype. Before production use, additional
        authentication, authorisation, encryption, audit logging and POPIA-aligned controls
        should be added.
    </p>
</div>

