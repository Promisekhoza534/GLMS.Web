@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
}

<h1>Create Service Request</h1>

<div class="form-page">
    <form asp-action="Create">
        <div class="form-group mb-3">
            <label asp-for="RequestTitle" class="control-label"></label>
            <input asp-for="RequestTitle" class="form-control" />
            <span asp-validation-for="RequestTitle" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="RequestDate" class="control-label"></label>
            <input asp-for="RequestDate" class="form-control" type="date" />
            <span asp-validation-for="RequestDate" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ContractId" class="control-label"></label>
            <select asp-for="ContractId" class="form-control" asp-items="ViewBag.ContractId"></select>
            <span asp-validation-for="ContractId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="AmountUsd" class="control-label"></label>
            <input asp-for="AmountUsd" class="form-control" />
            <span asp-validation-for="AmountUsd" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success me-2">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}